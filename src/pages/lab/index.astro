---
import Layout from '../../layouts/Layout.astro';
import { statSync } from 'node:fs';
import { labs } from '../../labs';

const base = import.meta.env.BASE_URL;
const sorted = [...labs].sort((a, b) => b.date.localeCompare(a.date));
const poster = (path: string) => `${base}${path}?v=${Math.round(statSync(`public/${path}`).mtimeMs).toString(36)}`;
---

<Layout title="Lab · Pleasure1234" description="Small interactive UI experiments by Pleasure1234.">
  <main class="lab-index">
    <header>
      <a class="back" href={base}>← home</a>
      <h1>Lab</h1>
      <p>A dream of becoming a UI designer.</p>
    </header>
    <ul class="grid">
      {sorted.map((lab) => (
        <li>
          <article class="card">
            <div class="preview">
              <img
                src={poster(lab.poster)}
                alt=""
                loading="lazy"
                decoding="async"
                class:list={{ pixelated: lab.pixelated }}
              />
            </div>
            <div class="meta">
              <h2><a href={`${base}lab/${lab.slug}`}>{lab.title}</a></h2>
              <time datetime={lab.date}>{lab.date}</time>
            </div>
            <p>{lab.description}</p>
            <p class="lab-credit">
              {lab.credit ? (
                <>credit by <a href={lab.credit.href} target="_blank" rel="noreferrer">{lab.credit.name}</a></>
              ) : (
                'original design'
              )}
            </p>
          </article>
        </li>
      ))}
    </ul>
  </main>
</Layout>

<style>
  .lab-index {
    width: min(calc(100% - 2rem), 60rem);
    margin-inline: auto;
    padding-block: 3.5rem;
  }

  header {
    margin-bottom: 2rem;
  }

  h1 {
    margin: 0.75rem 0 0.25rem;
    font-weight: 500;
    font-size: 1.75rem;
  }

  header p {
    margin: 0;
    font-size: 0.875rem;
    opacity: 0.65;
  }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: 1.25rem;
  }

  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    height: 100%;
    padding: 0.75rem;
    border: 1px solid color-mix(in srgb, var(--ink) 10%, transparent);
    border-radius: 0.75rem;
    color: inherit;
    text-decoration: none;
    transition: border-color 200ms ease, transform 200ms ease;
  }

  .card:hover,
  .card:focus-within {
    border-color: color-mix(in srgb, var(--ink) 35%, transparent);
    transform: translateY(-2px);
  }

  .preview {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 0.5rem;
    background: color-mix(in srgb, var(--ink) 4%, var(--paper));
  }

  .preview img {
    position: absolute;
    inset: 4%;
    width: 92%;
    height: 92%;
    object-fit: contain;
  }

  .preview img.pixelated {
    image-rendering: pixelated;
  }

  .meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
  }

  h2 {
    margin: 0;
    font-weight: 500;
    font-size: 1rem;
  }

  time {
    font-family: var(--hand);
    font-size: 0.625rem;
    opacity: 0.5;
  }

  h2 a {
    color: inherit;
    text-decoration: none;
  }

  h2 a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  h2 a:focus-visible {
    outline: none;
  }

  .card .lab-credit {
    position: relative;
    z-index: 1;
    width: fit-content;
    margin-top: auto;
    font-family: var(--hand);
    font-size: 0.6875rem;
    opacity: 0.55;
  }

  .lab-credit a {
    color: inherit;
    text-underline-offset: 0.2em;
  }

  .lab-credit a:hover {
    opacity: 1;
  }

  .card p {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.5;
    opacity: 0.7;
  }
</style>
