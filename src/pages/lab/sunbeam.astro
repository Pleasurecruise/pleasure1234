---
import Layout from '../../layouts/Layout.astro';

const base = import.meta.env.BASE_URL;
---

<Layout title="Sunbeam · Lab" description="Sunbeam: a pen-and-wash cat that keeps your local time.">
  <main class="lab">
    <a class="back back-pinned" href={`${base}lab`}>← lab</a>
    <canvas
      id="room"
      class="focus-ring"
      tabindex="0"
      aria-label="Your cat in a sunlit room, with a cardboard box, a yarn ball, a food bowl and a bookcase it can jump onto. Drag over the cat to pet it, press and hold it to pick it up and put it down somewhere else, tap it to make it meow, tap the bowl to fill it, and carry or throw the yarn, the box and the dish anywhere on the floor or onto the bookcase. Keys: Enter pets, F fills the bowl, Space throws the yarn, M calls the cat, B taps the box, T throws the box."
    ></canvas>
    <a class="sfx-credit" href="https://sonilo.com/royalty-free-sound-effects/cat" target="_blank" rel="noopener">Sound effects by Sonilo</a>
  </main>
</Layout>

<style>
  .lab {
    width: min(calc(100% - 2rem), 75rem);
    padding-block: 1rem;
  }

  canvas {
    display: block;
    width: min(100%, calc((100svh - 3rem) * 316 / 290));
    aspect-ratio: 316 / 290;
    height: auto;
    touch-action: none;
  }

  .sfx-credit {
    position: fixed;
    right: 1rem;
    bottom: 0.75rem;
    z-index: 100;
    font-family: var(--hand);
    font-size: 0.75rem;
    color: color-mix(in srgb, var(--ink) 55%, transparent);
    text-decoration: none;
  }

  .sfx-credit:hover {
    color: var(--ink);
    text-decoration: underline;
  }
</style>

<script>
  import { byId } from '../../lib/dom';
  import { mountSunbeam } from '../../labs/sunbeam';

  mountSunbeam(byId('room', HTMLCanvasElement), `${import.meta.env.BASE_URL}lab/sunbeam/sfx/`);
</script>
