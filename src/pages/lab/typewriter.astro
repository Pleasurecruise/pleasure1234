---
import Layout from '../../layouts/Layout.astro';
import { version } from '@msime/web-engine';

const base = import.meta.env.BASE_URL;
---

<Layout title="Typewriter · Lab" description="Typewriter: a pinyin input method whose candidates are type bars.">
  <main class="lab tw">
    <a class="back back-pinned" href={`${base}lab`}>← lab</a>

    <div class="machine" id="tw-machine">
      <div class="tw-window" id="tw-window">
        <div class="tw-carriage" id="tw-carriage">
          <div class="tw-feed" id="tw-feed">
            <label class="sr-only" for="tw-paper">Paper</label>
            <textarea class="tw-paper" id="tw-paper" spellcheck="false" autocomplete="off" placeholder="打几个拼音试试"></textarea>
          </div>
          <button class="tw-lever" id="tw-lever" type="button" aria-label="Carriage return: start a new line">
            <svg viewBox="0 0 48 28" aria-hidden="true"><path d="M46 22H20q-6 0-9-6L4 4" /><circle cx="4" cy="4" r="3" /></svg>
          </button>
        </div>
        <span class="tw-bail" aria-hidden="true"></span>
        <span class="tw-guide" aria-hidden="true"></span>
        <span class="tw-bell" id="tw-bell" aria-hidden="true">
          <svg viewBox="0 0 20 20"><path d="M10 3a5 5 0 0 0-5 5v4l-2 2h14l-2-2V8a5 5 0 0 0-5-5zM8 16a2 2 0 0 0 4 0" /></svg>
        </span>
        <input
          class="tw-keys"
          id="tw-keys"
          type="password"
          aria-label="Pinyin keys. What you type is struck onto the paper"
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
          data-1p-ignore
          data-lpignore="true"
          data-bwignore
          data-form-type="other"
        />
      </div>

      <span class="tw-pencil" id="tw-pencil" aria-hidden="true" hidden></span>
      <div class="tw-basket" id="tw-basket" role="listbox" aria-label="Type bars"></div>

      <div class="tw-deck">
        <button class="tw-key tw-key-small" id="tw-prev" type="button" aria-label="Previous type bars" disabled>‹</button>
        <button class="tw-key" id="tw-shift" type="button" aria-pressed="false" aria-label="Shift lock: English letters">
          <span class="tw-key-face">中</span>
          <span class="tw-key-label">shift lock</span>
        </button>
        <button class="tw-key" id="tw-scheme" type="button">
          <span class="tw-key-face">全拼</span>
          <span class="tw-key-label">pinyin</span>
        </button>
        <button class="tw-key tw-key-small" id="tw-next" type="button" aria-label="Next type bars" disabled>›</button>
      </div>
      <p class="tw-status" id="tw-status" aria-live="polite"></p>
    </div>

    <p class="tw-credit">
      Input engine: <a href="https://github.com/metasequoiaime/msime" target="_blank" rel="noopener">水杉输入法 Shuishan IME</a> web engine {version}, GPL-3.0
    </p>
  </main>
</Layout>

<style>
  .tw {
    --type: 'Courier New', 'Songti SC', 'STSong', 'Noto Serif SC', 'Source Han Serif SC', monospace;
    --cjk: 'Songti SC', 'STSong', 'Noto Serif SC', 'Source Han Serif SC', var(--serif);
    --line: color-mix(in srgb, var(--ink) 14%, transparent);
    --spring: cubic-bezier(0.34, 1.56, 0.64, 1);
    width: min(calc(100% - 2rem), 46rem);
    padding-block: 3rem 1.25rem;
    gap: 0.8rem;
  }

  .machine {
    --strike-gap: 46;
    --radius: 10.5;
    position: relative;
    width: 100%;
    display: grid;
    justify-items: center;
  }

  .tw-window {
    position: relative;
    width: 100%;
    height: 13.5rem;
    overflow: hidden;
    border: 1.5px solid color-mix(in srgb, var(--ink) 55%, transparent);
    border-bottom: 0;
    border-radius: 1.4rem 1.4rem 0 0;
    background:
      radial-gradient(120% 90% at 50% 100%, color-mix(in srgb, var(--ink) 3%, var(--paper)), color-mix(in srgb, var(--ink) 7%, var(--paper)));
  }

  .tw-carriage {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 26rem;
    transition: transform 170ms cubic-bezier(0.3, 0.7, 0.4, 1);
  }

  .tw-carriage:global(.is-returning) {
    transition: transform 460ms cubic-bezier(0.6, 0, 0.25, 1);
  }

  .tw-feed {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    transition: transform 220ms cubic-bezier(0.3, 0.7, 0.4, 1);
  }

  .tw-paper {
    display: block;
    width: 100%;
    min-height: 30rem;
    padding: 2rem 1.6rem 12rem;
    border: 0;
    border-radius: 2px;
    outline: none;
    resize: none;
    overflow: hidden;
    background: color-mix(in srgb, white 75%, var(--paper));
    box-shadow: 0 0 0 1px var(--line), 0 6px 18px -8px color-mix(in srgb, var(--ink) 25%, transparent);
    color: var(--ink);
    caret-color: transparent;
    font: 400 1.15rem/2rem var(--type);
    letter-spacing: 0.02em;
    cursor: text;
  }

  .tw-paper::placeholder {
    color: color-mix(in srgb, var(--ink) 30%, transparent);
  }

  .tw-lever {
    position: absolute;
    left: -3.6rem;
    bottom: calc(var(--strike-gap) * 1px - 0.6rem);
    width: 3.4rem;
    height: 2rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink);
    cursor: pointer;
    transform-origin: 100% 80%;
  }

  .tw-lever svg {
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.4;
    stroke-linecap: round;
  }

  .tw-lever circle {
    fill: currentColor;
  }

  .tw-lever:hover {
    transform: rotate(-6deg);
  }

  .tw-lever:global(.is-thrown) {
    animation: throw 460ms ease-in-out;
  }

  @keyframes throw {
    30% { transform: rotate(-24deg) translateX(-6px); }
  }

  .tw-bail {
    position: absolute;
    left: 6%;
    right: 6%;
    bottom: calc(var(--strike-gap) * 1px - 1.25rem);
    height: 2px;
    background: color-mix(in srgb, var(--ink) 55%, transparent);
    pointer-events: none;
  }

  .tw-bail::before,
  .tw-bail::after {
    content: '';
    position: absolute;
    top: -3px;
    width: 0.9rem;
    height: 8px;
    border-radius: 4px;
    background: var(--ink);
  }

  .tw-bail::before {
    left: 22%;
  }

  .tw-bail::after {
    right: 22%;
  }

  .tw-guide {
    position: absolute;
    left: 50%;
    bottom: calc(var(--strike-gap) * 1px - 1.4rem);
    width: 1.6rem;
    height: 0.65rem;
    margin-left: -0.8rem;
    border: 1.5px solid var(--ink);
    border-top: 0;
    border-radius: 0 0 0.4rem 0.4rem;
    pointer-events: none;
  }

  .tw-pencil {
    position: absolute;
    left: 50%;
    top: 14.1rem;
    z-index: 2;
    transform: translateX(-50%);
    padding: 0.05rem 0.4rem;
    color: color-mix(in srgb, var(--ink) 60%, transparent);
    font: italic 400 0.95rem/1.3 var(--hand);
    white-space: nowrap;
    pointer-events: none;
  }

  .tw-pencil :global(.tw-pencil-caret) {
    display: inline-block;
    width: 1px;
    height: 0.9em;
    margin-inline: 1px;
    vertical-align: -0.1em;
    background: currentColor;
    animation: blink 1s steps(1) infinite;
  }

  .tw-window :global(.tw-ink) {
    position: absolute;
    color: var(--ink);
    font: 700 1.15rem/2rem var(--type);
    letter-spacing: 0.02em;
    white-space: pre;
    pointer-events: none;
  }

  .tw-bell {
    position: absolute;
    top: 0.8rem;
    right: 1.1rem;
    width: 1.15rem;
    height: 1.15rem;
    color: color-mix(in srgb, var(--ink) 55%, transparent);
    transform-origin: 50% 10%;
  }

  .tw-bell svg {
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linejoin: round;
  }

  .tw-bell:global(.is-ringing) {
    animation: ring 700ms ease-out;
    color: var(--ink);
  }

  @keyframes ring {
    15% { transform: rotate(22deg); }
    30% { transform: rotate(-18deg); }
    45% { transform: rotate(12deg); }
    60% { transform: rotate(-7deg); }
    75% { transform: rotate(3deg); }
  }

  .tw-keys {
    position: absolute;
    left: 1rem;
    top: 1rem;
    width: 1px;
    height: 1px;
    padding: 0;
    border: 0;
    opacity: 0;
    pointer-events: none;
  }

  .tw-basket {
    position: absolute;
    left: 50%;
    top: calc(13.5rem - var(--strike-gap) * 1px);
    z-index: 3;
    width: 0;
    height: 0;
  }

  .machine::after {
    content: '';
    order: 1;
    width: 100%;
    height: calc(var(--radius) * 1rem + 3.2rem - var(--strike-gap) * 1px);
    border: 1.5px solid color-mix(in srgb, var(--ink) 55%, transparent);
    border-top: 1.5px solid var(--ink);
    border-radius: 0 0 50% 50% / 0 0 32% 32%;
    background: color-mix(in srgb, var(--ink) 3%, var(--paper));
  }

  .tw-deck {
    order: 2;
    display: flex;
    gap: 0.9rem;
    align-items: flex-start;
    margin-top: 0.8rem;
    position: relative;
    z-index: 2;
  }

  .tw-status {
    order: 3;
  }

  .tw-basket :global(.tw-bar) {
    position: absolute;
    left: 0;
    top: 0;
    width: 0;
    height: 0;
    padding: 0;
    border: 0;
    background: none;
    transform: rotate(var(--a));
    cursor: pointer;
  }

  .tw-basket :global(.tw-stick) {
    position: absolute;
    left: 0;
    top: 0;
    transform: translateY(calc(var(--radius) * 1rem));
    transition: transform 200ms var(--spring);
  }

  .tw-basket :global(.tw-bar.is-up .tw-stick),
  .tw-basket :global(.tw-bar:hover .tw-stick) {
    transform: translateY(calc(var(--radius) * 1rem - 0.8rem));
  }

  .tw-basket :global(.tw-arm) {
    position: absolute;
    left: -1px;
    top: 0.9rem;
    width: 2px;
    height: 2.4rem;
    background: color-mix(in srgb, var(--ink) 55%, transparent);
  }

  .tw-basket :global(.tw-arm)::after {
    content: '';
    position: absolute;
    left: -2.5px;
    bottom: -3px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ink);
  }

  .tw-basket :global(.tw-slug) {
    position: absolute;
    left: 0;
    top: 0;
    padding: 0.18rem 0.32rem;
    border: 1px solid color-mix(in srgb, var(--ink) 45%, transparent);
    border-radius: 3px;
    background: linear-gradient(color-mix(in srgb, white 60%, var(--paper)), color-mix(in srgb, var(--ink) 7%, var(--paper)));
    color: var(--ink);
    font: 400 1.1rem/1.15 var(--cjk);
    white-space: nowrap;
    transform: translate(-50%, -50%) rotate(calc(-1 * var(--a)));
    box-shadow: 0 2px 4px -2px color-mix(in srgb, var(--ink) 30%, transparent);
  }

  .tw-basket :global(.tw-slug.is-wide) {
    font-size: 0.92rem;
  }

  .tw-basket :global(.tw-slug.is-long) {
    font-size: 0.76rem;
  }

  .tw-basket :global(.tw-bar.is-up .tw-slug) {
    border-color: var(--ink);
    box-shadow: 0 0 0 1px var(--ink), 0 4px 8px -3px color-mix(in srgb, var(--ink) 40%, transparent);
  }

  .tw-basket :global(.tw-bar.is-striking .tw-slug) {
    background: var(--ink);
    color: var(--paper);
  }

  .tw-basket :global(.tw-num) {
    position: absolute;
    left: 0;
    top: 3.75rem;
    transform: translateX(-50%) rotate(calc(-1 * var(--a)));
    font-family: var(--hand);
    font-size: 0.62rem;
    opacity: 0.55;
  }

  .tw-basket :global(.tw-bar:disabled) {
    cursor: default;
  }

  .tw-basket :global(.tw-slug.is-blank) {
    width: 1.1rem;
    height: 1.35rem;
    padding: 0;
    opacity: 0.45;
  }

  .tw-basket :global(.tw-bar:disabled .tw-arm),
  .tw-basket :global(.tw-bar:disabled .tw-num) {
    opacity: 0.45;
  }

  .tw-key {
    display: grid;
    justify-items: center;
    gap: 0.25rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink);
    cursor: pointer;
  }

  .tw-key-face {
    width: 3rem;
    height: 3rem;
    display: grid;
    place-items: center;
    border: 1.5px solid var(--ink);
    border-radius: 50%;
    background: radial-gradient(circle at 50% 35%, color-mix(in srgb, white 60%, var(--paper)), color-mix(in srgb, var(--ink) 8%, var(--paper)));
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--ink) 10%, transparent), 0 3px 0 color-mix(in srgb, var(--ink) 35%, transparent);
    font: 500 0.95rem/1 var(--cjk);
    transition: transform 120ms ease, box-shadow 120ms ease;
  }

  .tw-key:active .tw-key-face,
  .tw-key[aria-pressed='true'] .tw-key-face {
    transform: translateY(2px);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--ink) 10%, transparent), 0 1px 0 color-mix(in srgb, var(--ink) 35%, transparent);
  }

  .tw-key-label {
    font-family: var(--hand);
    font-size: 0.6rem;
    opacity: 0.55;
  }

  .tw-key-small {
    width: 2.2rem;
    height: 2.2rem;
    margin-top: 0.4rem;
    place-items: center;
    border: 1.5px solid color-mix(in srgb, var(--ink) 50%, transparent);
    border-radius: 50%;
    font: 1.1rem/1 var(--serif);
  }

  .tw-key-small:disabled {
    opacity: 0.25;
    cursor: default;
  }

  .tw-status {
    min-height: 1rem;
    margin: 0.4rem 0 0;
    font-family: var(--hand);
    font-size: 0.75rem;
    opacity: 0.65;
  }

  .tw-credit {
    margin: 0;
    font-family: var(--hand);
    font-size: 0.65rem;
    text-align: center;
    opacity: 0.5;
  }

  .tw-credit a {
    color: inherit;
    text-underline-offset: 0.2em;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  :focus-visible {
    outline: 2px solid color-mix(in srgb, var(--ink) 45%, transparent);
    outline-offset: 2px;
  }

  @media (max-width: 34rem) {
    .machine {
      --radius: 8.6;
    }

    .tw-basket :global(.tw-slug) {
      font-size: 0.9rem;
    }

    .tw-basket :global(.tw-slug.is-wide) {
      font-size: 0.72rem;
    }

    .tw-basket :global(.tw-slug.is-long) {
      font-size: 0.6rem;
    }

    .tw-carriage {
      width: 18rem;
    }
  }
</style>

<script>
  import { byId } from '../../lib/dom';
  import { mountTypewriter } from '../../labs/typewriter';

  mountTypewriter({
    machine: byId('tw-machine', HTMLElement),
    window: byId('tw-window', HTMLElement),
    carriage: byId('tw-carriage', HTMLElement),
    feed: byId('tw-feed', HTMLElement),
    paper: byId('tw-paper', HTMLTextAreaElement),
    keys: byId('tw-keys', HTMLInputElement),
    pencil: byId('tw-pencil', HTMLElement),
    basket: byId('tw-basket', HTMLElement),
    lever: byId('tw-lever', HTMLButtonElement),
    bell: byId('tw-bell', HTMLElement),
    shiftLock: byId('tw-shift', HTMLButtonElement),
    scheme: byId('tw-scheme', HTMLButtonElement),
    prev: byId('tw-prev', HTMLButtonElement),
    next: byId('tw-next', HTMLButtonElement),
    status: byId('tw-status', HTMLElement),
    base: import.meta.env.BASE_URL,
  });
</script>
