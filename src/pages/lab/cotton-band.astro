---
import Layout from '../../layouts/Layout.astro';

const base = import.meta.env.BASE_URL;
---

<Layout title="Cotton Band · Lab" description="Cotton Band: BanG Dream! plushies with real physics.">
  <main class="lab">
    <a class="back back-pinned" href={`${base}lab`}>← lab</a>
    <div class="stage" id="stage" data-assets={`${base}lab/cotton-band/`}>
      <svg class="desk" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
        <defs>
          <linearGradient id="cb-top" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#f1efeb" />
            <stop offset="0.55" stop-color="#fbfaf8" />
            <stop offset="1" stop-color="#ffffff" />
          </linearGradient>
          <linearGradient id="cb-edge" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#ebe8e3" />
            <stop offset="1" stop-color="#d9d5ce" />
          </linearGradient>
          <linearGradient id="cb-sheen" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="#fff" stop-opacity="0" />
            <stop offset="0.5" stop-color="#fff" stop-opacity="0.9" />
            <stop offset="1" stop-color="#fff" stop-opacity="0" />
          </linearGradient>
        </defs>
        <polygon points="7,50 93,50 100,86 0,86" fill="url(#cb-top)" />
        <polygon points="30,52 60,52 52,84 14,84" fill="url(#cb-sheen)" opacity="0.55" />
        <polygon points="0,86 100,86 100,90.5 0,90.5" fill="url(#cb-edge)" />
        <line x1="0" y1="86" x2="100" y2="86" stroke="#fff" stroke-width="0.35" vector-effect="non-scaling-stroke" />
        <polygon points="7,50 93,50 100,86 0,86" fill="none" stroke="#e2dfda" stroke-width="1" vector-effect="non-scaling-stroke" />
      </svg>
      <div class="cabinet" id="cabinet" aria-label="Toy box"></div>
      <div class="layer" id="layer"></div>
    </div>
    <p class="lab-hint">
      <span id="hint">Draw one from the toy box. Stack, knock over, pat a head; drop one on the box to put it back.</span>
      <button type="button" id="line-up">line up</button>
    </p>
  </main>
</Layout>

<style>
  .stage {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
  }

  @media (max-width: 40rem) {
    .stage {
      aspect-ratio: 1 / 1;
    }
  }

  .desk {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    filter: drop-shadow(0 10px 14px rgb(41 37 36 / 0.08)) drop-shadow(0 2px 3px rgb(41 37 36 / 0.06));
  }

  .layer {
    position: absolute;
    inset: 0;
  }

  .lab-hint {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: baseline;
    gap: 0.75rem;
    opacity: 1;
  }

  #hint {
    opacity: 0.55;
  }

  .lab-hint button {
    padding: 0.15rem 0.6rem;
    border: 1px solid color-mix(in srgb, var(--ink) 18%, transparent);
    border-radius: 999px;
    background: none;
    color: inherit;
    font: inherit;
    opacity: 0.7;
    cursor: pointer;
  }

  .lab-hint button:hover {
    opacity: 1;
  }

  .cabinet {
    position: absolute;
    z-index: 2;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    padding: calc(var(--cw, 200px) * 0.06) calc(var(--cw, 200px) * 0.06) calc(var(--cw, 200px) * 0.045);
    border: 1px solid color-mix(in srgb, var(--ink) 9%, transparent);
    border-radius: 12% / 10%;
    background: linear-gradient(180deg, #ffffff, #f3f2ef);
    box-shadow: 0 12px 20px rgb(41 37 36 / 0.1), 0 2px 4px rgb(41 37 36 / 0.06), inset 0 1px 0 #fff;
    container-type: size;
  }

  .cabinet :global(.cab-glass) {
    position: relative;
    flex: 1;
    overflow: hidden;
    border-radius: 9% / 8%;
    background: linear-gradient(180deg, #fbfbfc, #ececef);
    box-shadow: inset 0 0 0 1px rgb(41 37 36 / 0.06), inset 0 8px 16px rgb(41 37 36 / 0.05);
  }

  .cabinet :global(.cab-claw) {
    position: absolute;
    inset: 0;
    z-index: 300;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .cabinet :global(.cab-claw .rail) { stroke: #cfcdd2; stroke-linecap: round; }
  .cabinet :global(.cab-claw .carriage) { fill: #b8b6bc; }
  .cabinet :global(.cab-claw .spring) { fill: none; stroke: #8f8d94; stroke-linejoin: round; }
  .cabinet :global(.cab-claw .band) { fill: #e0524c; }
  .cabinet :global(.cab-claw .prong) { fill: none; stroke: #7b7980; stroke-linecap: round; stroke-linejoin: round; }
  .cabinet :global(.cab-claw .hub) { fill: #6d6b72; }

  .cabinet :global(.cab-pile) {
    position: absolute;
    inset: 0;
  }

  .cabinet :global(.cab-toy) {
    position: absolute;
    top: 0;
    left: 0;
    pointer-events: none;
    user-select: none;
    transition: transform 500ms cubic-bezier(0.3, 1.25, 0.5, 1);
  }

  .cabinet :global(.cab-toy.carried) {
    transition: none;
  }

  .cabinet :global(.cab-shine) {
    position: absolute;
    inset: 0;
    z-index: 301;
    background: linear-gradient(115deg, transparent 30%, rgb(255 255 255 / 0.55) 38%, transparent 46%, transparent 58%, rgb(255 255 255 / 0.3) 62%, transparent 68%);
    pointer-events: none;
  }

  .cabinet :global(.cab-panel) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 4cqw;
    height: 19cqh;
    padding-top: 4cqh;
  }

  .cabinet :global(.cab-count) {
    font-family: var(--hand);
    font-size: 7cqw;
    line-height: 1.1;
    opacity: 0.55;
  }

  .cabinet :global(.cab-draw) {
    flex: none;
    height: 100%;
    aspect-ratio: 1;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #ff8c82, #e5483f 58%, #c63a33);
    box-shadow: 0 3px 0 #a92f29, 0 5px 8px rgb(0 0 0 / 0.15), inset 0 1px 1px rgb(255 255 255 / 0.5);
    color: #fff;
    font-family: var(--hand);
    font-size: 5.6cqw;
    cursor: pointer;
    transition: transform 80ms ease, box-shadow 80ms ease, opacity 150ms ease;
  }

  .cabinet :global(.cab-draw:active:not(:disabled)) {
    transform: translateY(2px);
    box-shadow: 0 1px 0 #a92f29, 0 2px 4px rgb(0 0 0 / 0.15), inset 0 1px 1px rgb(255 255 255 / 0.5);
  }

  .cabinet :global(.cab-draw:disabled) {
    opacity: 0.45;
    cursor: default;
  }

  .cabinet :global(.cab-draw:focus-visible) {
    outline: 2px solid color-mix(in srgb, var(--ink) 40%, transparent);
    outline-offset: 2px;
  }

  .stage :global(.cb-plush) {
    position: absolute;
    top: 0;
    left: 0;
    transform-origin: 0 0;
    outline: none;
    pointer-events: none;
    will-change: transform;
  }

  .stage :global(.cb-gl) {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 5;
    pointer-events: none;
  }

  .stage :global(.cb-plush img) {
    display: block;
    width: 100%;
    height: 100%;
    user-select: none;
    -webkit-user-drag: none;
  }

  .stage :global(.cb-plush:focus-visible img) {
    filter: drop-shadow(0 0 3px color-mix(in srgb, var(--c) 70%, transparent));
  }

  .stage:global(.hovering) {
    cursor: grab;
  }

  .stage:global(.grabbing) {
    cursor: grabbing;
  }

  .stage :global(.cb-shadow) {
    position: absolute;
    top: 0;
    left: 0;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(80 70 60 / 0.42), rgb(80 70 60 / 0.16) 60%, transparent);
    pointer-events: none;
  }

  .stage :global(.cb-shadow.focus) {
    background: radial-gradient(closest-side, color-mix(in srgb, var(--c) 70%, transparent), transparent);
    opacity: 1 !important;
  }

  .stage :global(.cb-note) {
    position: absolute;
    z-index: 99;
    font-family: var(--hand);
    font-weight: 600;
    line-height: 1;
    pointer-events: none;
    translate: -50% -50%;
    text-shadow: 0 1px 0 #fff;
    animation: cb-note 1.1s ease-out forwards;
  }

  @keyframes cb-note {
    from {
      opacity: 0;
      transform: translate(0, 0) scale(0.6) rotate(0deg);
    }
    20% {
      opacity: 1;
    }
    to {
      opacity: 0;
      transform: translate(var(--dx), -3em) scale(1.1) rotate(var(--r));
    }
  }
</style>

<script>
  import { byId, need } from '../../lib/dom';
  import { CATALOG, mountDesk } from '../../labs/cotton-band';
  import { mountBox } from '../../labs/cotton-band-box';

  const hint = byId('hint', HTMLElement);
  const stage = byId('stage', HTMLElement);
  const cabinet = byId('cabinet', HTMLElement);
  const assets = need(stage.dataset.assets, 'data-assets on the stage');
  const say = (text: string) => { hint.textContent = text; };

  const all = CATALOG.flatMap((set) => set.members);
  let onDesk = new Set<string>();
  const box = mountBox(
    cabinet,
    assets,
    (m, rect, angle, spin) => desk.launch(m.id, rect, angle, spin),
    () => say('The box is empty'),
  );
  const desk = mountDesk(
    stage,
    byId('layer', HTMLElement),
    cabinet,
    assets,
    say,
    (ids) => {
      onDesk = ids;
      box.set(all.filter((m) => !onDesk.has(m.id)));
    },
    (x, y) => box.contains(x, y),
  );
  byId('line-up', HTMLButtonElement).addEventListener('click', () => desk.lineUp());
</script>
